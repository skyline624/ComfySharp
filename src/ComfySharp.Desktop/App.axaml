<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ComfySharp.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml" />
    <Style Selector="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,7"/></Style>
  </Application.Styles>
</Application>
