<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:n="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia" xmlns:c="clr-namespace:Nodify.Avalonia.Connections;assembly=Nodify.Avalonia" x:Class="ComfySharp.Desktop.DocumentEditor">
  <Grid ColumnDefinitions="*,300">
    <n:NodifyEditor x:Name="Canvas" Background="#171B25" GridCellSize="10" KeyDown="CanvasKeyDown">
      <n:NodifyEditor.Styles>
        <Style Selector="n|ItemContainer"><Setter Property="Location" Value="{ReflectionBinding Location, Mode=TwoWay}"/></Style>
      </n:NodifyEditor.Styles>
      <n:NodifyEditor.ItemTemplate>
        <DataTemplate>
          <Border Background="#283044" BorderBrush="{ReflectionBinding Outline}" BorderThickness="2" CornerRadius="7" Padding="14" Width="230">
            <StackPanel Spacing="6">
              <TextBlock Text="{ReflectionBinding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
              <TextBlock Text="{ReflectionBinding Subtitle}" Foreground="#B9C5DB" TextWrapping="Wrap"/>
              <TextBlock Text="{ReflectionBinding Ports}" FontSize="12" TextWrapping="Wrap"/>
              <TextBox IsVisible="{ReflectionBinding IsPreview}" Text="{ReflectionBinding PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="60" MaxHeight="220" FontFamily="monospace"/>
              <ContentControl Content="{ReflectionBinding ImagePreview}" IsVisible="{ReflectionBinding HasImagePreview}">
                <ContentControl.ContentTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="5">
                      <Image Source="{ReflectionBinding Image}" MaxHeight="220" Stretch="Uniform"/>
                      <TextBlock Text="{ReflectionBinding Status}" TextWrapping="Wrap"/>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Content="←" Command="{ReflectionBinding Previous}" ToolTip.Tip="Previous image"/>
                        <TextBlock Grid.Column="1" Text="{ReflectionBinding Position}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="→" Command="{ReflectionBinding Next}" ToolTip.Tip="Next image"/>
                      </Grid>
                      <TextBlock Text="{ReflectionBinding Filename}" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </n:NodifyEditor.ItemTemplate>
      <n:NodifyEditor.ConnectionTemplate>
        <DataTemplate><c:Connection Source="{ReflectionBinding Source}" Target="{ReflectionBinding Target}" Foreground="#8AA9FA"/></DataTemplate>
      </n:NodifyEditor.ConnectionTemplate>
    </n:NodifyEditor>
    <ScrollViewer Grid.Column="1" Background="#202632">
      <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Graph tools" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Wheel: zoom · Right-drag: pan&#10;Click / drag: select and move" TextWrapping="Wrap" Foreground="#B9C5DB"/>
        <ComboBox x:Name="NodeTypes" HorizontalAlignment="Stretch"/>
        <Button Content="Add node" Click="AddClicked"/>
        <TextBlock Text="Selected node" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <Button Content="Inspect selection" Click="InspectClicked"/>
        <TextBox x:Name="NodeTitle" PlaceholderText="Node title"/>
        <TextBox x:Name="Widgets" PlaceholderText="Widget values (JSON array / object)" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"/>
        <Button Content="Apply title and widgets" Click="ApplyClicked"/>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="EnableNode" Content="Enable" Click="EnableClicked"/>
          <Button x:Name="MuteNode" Content="Mute" Click="MuteClicked"/>
          <Button x:Name="BypassNode" Content="Bypass" Click="BypassClicked"/>
        </StackPanel>
        <Button Content="Delete selection" Click="DeleteClicked"/>
        <Button x:Name="DuplicateNodes" Content="Duplicate selection" Click="DuplicateClicked"/>
        <Button x:Name="DuplicateWithInputs" Content="Duplicate with external inputs" Click="DuplicateWithInputsClicked"/>
        <Button x:Name="CopyNodes" Content="Copy nodes" Click="CopyClicked"/>
        <Button x:Name="PasteNodes" Content="Paste nodes" Click="PasteClicked"/>
        <TextBlock Text="Connect ports" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <TextBlock Text="Use the IDs and zero-based slot numbers shown on each node." TextWrapping="Wrap"/>
        <TextBox x:Name="SourceId" PlaceholderText="Source node ID"/><TextBox x:Name="SourceSlot" Text="0" PlaceholderText="Output slot"/>
        <TextBox x:Name="TargetId" PlaceholderText="Target node ID"/><TextBox x:Name="TargetSlot" Text="0" PlaceholderText="Input slot"/>
        <Button Content="Connect" Click="ConnectClicked"/>
        <TextBox x:Name="LinkId" PlaceholderText="Link ID to disconnect"/><Button Content="Disconnect" Click="DisconnectClicked"/>
        <TextBlock x:Name="LinkSummary" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
