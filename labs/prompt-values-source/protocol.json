    "custom validation overrides",
    "rawLink",
    "ACCEPT_ALL_INPUTS",
    "non-finite numbers",
    "unbounded integers or coercions",
    "node execution including PreviewAny.main",
    "native imports",
    "external prompt replacement hooks",
    "HTTP transport"
  ],
